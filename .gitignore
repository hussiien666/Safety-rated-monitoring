# ─────────────────────────────────────────────────────────────
#  GRAD VISION — Cobot Vision Safety System  ·  .gitignore
# ─────────────────────────────────────────────────────────────

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Biometric / personal data (kept OUT of the repo) ---
# Rebuild locally with:  py build_database.py
known_faces/
faces_db.npz

# --- Runtime output ---
snapshots/

# --- Local backups & archives ---
Project Backups/
*.zip
*.7z
*.rar

# --- CAD / SolidWorks export logs (large, not needed to run) ---
*.log
export.log

# --- Editor / OS / tooling ---
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
*.tmp
*.bak
